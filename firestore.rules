rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny: Blokir seluruh akses ke dokumen yang tidak diizinkan secara spesifik
    match /{document=**} {
      allow read, write: if false;
    }

    // Fungsi pembantu: Memeriksa apakah pengguna sudah login via Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Fungsi pembantu: Memverifikasi bahwa UID user yang login cocok dengan userId pada path dokumen
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validasi parameter ID
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Koleksi data Pengguna & seluruh subkoleksinya
    // Aturan ketat: Santri HANYA BISA membaca, membuat, mengubah, dan menghapus datanya sendiri!
    match /users/{userId} {
      // Dokumen utama profil user (/users/{userId})
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Subkoleksi: progress bab, quizResults (nilai kuis), savedVocab (hafalan), notes (catatan santri), dll
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
