rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to prevent unauthorized reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Root user document - strictly accessible only by the owner
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Subcollection: progress per chapter
      match /progress/{chapterId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(chapterId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: quiz results
      match /quizResults/{quizResultId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(quizResultId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: saved vocabularies for memorization
      match /savedVocab/{vocabId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(vocabId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: study notes
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(noteId);
        allow delete: if isOwner(userId);
      }
    }

    // Test connection doc check
    match /test/{docId} {
      allow read: if true;
    }
  }
}
